%% title: Subscription and B2B Drone Lease State Machines
stateDiagram-v2
  direction LR
  state "Enterprise Subscription (subscriptions.status)" as SubSM {
    [*] --> SUB_PENDING : requestEnterprise(partial unique index) [FR-03]
    SUB_PENDING --> SUB_ACTIVE : confirmPayment(partial unique index) / captureOrder(partial unique index) [FR-03]
    SUB_PENDING --> SUB_CANCELLED : cancel(partial unique index) [FR-03]
    SUB_ACTIVE --> SUB_PAST_DUE : markPastDue(partial unique index) [FR-03]
    SUB_PAST_DUE --> SUB_ACTIVE : confirmPayment(partial unique index) [FR-03]
    SUB_PAST_DUE --> SUB_SUSPENDED : suspend(partial unique index) [FR-03]
    SUB_SUSPENDED --> SUB_ACTIVE : confirmPayment(partial unique index) [FR-03]
    SUB_ACTIVE --> SUB_EXPIRED : expire(partial unique index) / superseded by renewal [FR-03]
    SUB_ACTIVE --> SUB_CANCELLED : cancel(partial unique index) [FR-03]
    SUB_EXPIRED --> [*]
    SUB_CANCELLED --> [*]
  }

  state "B2B Drone Lease (drone_leases.status)" as LeaseSM {
    [*] --> LEASE_PENDING : requestLease(partial unique index) [FR-05]
    LEASE_PENDING --> LEASE_ACTIVE : activateWire(partial unique index) / activatePayPal(partial unique index) [FR-05]
    LEASE_PENDING --> LEASE_CANCELLED : cancel(partial unique index) [FR-05]
    LEASE_ACTIVE --> LEASE_RECLAIMED : reclaim(partial unique index) [FR-05]
    LEASE_RECLAIMED --> [*]
    LEASE_CANCELLED --> [*]
  }
