%% title: MaintenanceWorkOrder 12-State Lifecycle Diagram
stateDiagram-v2
  direction TB
  [*] --> WO_DRAFT : createWorkOrder(partial unique index) [FR-15]
  WO_DRAFT --> AWAITING_APPROVAL : submitEstimate(partial unique index) [FR-15]
  AWAITING_APPROVAL --> APPROVED : approveEstimate(partial unique index) [FR-15]
  AWAITING_APPROVAL --> REWORK_REQUIRED : rejectEstimate(reason) [FR-15]
  REWORK_REQUIRED --> AWAITING_APPROVAL : submitEstimate(partial unique index) (revised) [FR-15]
  APPROVED --> READY : release(partial unique index) [FR-15]
  READY --> IN_PROGRESS : start(partial unique index) [FR-15]
  IN_PROGRESS --> WORK_COMPLETED : declareComplete(partial unique index) (all logs VERIFIED) [FR-15]
  WORK_COMPLETED --> SUBMITTED_FOR_ACCEPTANCE : submitCompletionReport(partial unique index) [FR-16]
  SUBMITTED_FOR_ACCEPTANCE --> ACCEPTED : recordAcceptance(ACCEPTED) [FR-16]
  SUBMITTED_FOR_ACCEPTANCE --> REWORK_REQUIRED : recordAcceptance(REWORK_REQUIRED) [FR-16]
  SUBMITTED_FOR_ACCEPTANCE --> REINSPECTION_REQUIRED : recordAcceptance(REINSPECTION_REQUIRED) [FR-16]
  REWORK_REQUIRED --> IN_PROGRESS : resumeAfterRework(partial unique index) [FR-15]
  REINSPECTION_REQUIRED --> IN_PROGRESS : resumeAfterReinspection(partial unique index) [FR-15]
  ACCEPTED --> COST_RECONCILED : reconcileCosts(actualLines) [FR-16]
  COST_RECONCILED --> CLOSED : close(partial unique index) [FR-16]
  CLOSED --> [*]
