  updated_at timestamptz [not null]
  row_version bigint [not null]
  last_timeout_cancelled_at timestamptz
  last_timeout_inspector_id uuid
}

Table inspections {
  id uuid [pk]
  asset_id uuid [not null]
  status varchar(32) [not null]
