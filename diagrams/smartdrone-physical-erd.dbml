  latitude "numeric(9,6)"
  longitude "numeric(9,6)"
  location_description varchar(1000)
  is_deleted boolean [not null]
  created_at timestamptz [not null]
  original_size_bytes bigint
  processing_status varchar(32) [not null]
  processing_error text
  raw_object_key varchar(1000)
  thumbnail_object_key varchar(1000)
  thumbnail_size_bytes bigint
  media_width integer
  media_height integer
  duration_seconds double
  processed_at timestamptz
  processing_attempts integer [not null]
  processing_locked_at timestamptz
  source_video_evidence_id uuid
  source_timestamp_seconds double
}

Table evidence_upload_sessions {
  id uuid [pk]
  inspection_id uuid [not null]
  field_session_id uuid
  created_by_user_id uuid [not null]
  file_name varchar(500) [not null]
