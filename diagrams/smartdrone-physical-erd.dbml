// SmartDroneInspection Physical Database Schema (PostgreSQL 17)
// Synced from Flyway migrations V1 - V69 (48 application tables + event_publication)

Table users {
  id uuid [pk]
  email varchar(320) [not null]
  normalized_email varchar(320) [unique, not null]
  full_name varchar(200) [not null]
  password_hash varchar(1024)
  status varchar(32) [not null]
  auth_version integer [not null]
  failed_login_count integer [not null]
  lockout_until timestamptz
  must_change_password boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  vision_fallback_enabled boolean [not null]
  phone_number varchar(32)
  avatar_url text
  roles varchar(255) [not null]
  otp_verified boolean [not null]
}

Table auth_sessions {
  id uuid [pk]
  user_id uuid [not null]
  client_type varchar(16) [not null]
  token_hash varchar(64) [unique]
  previous_token_hash varchar(64)
  issued_at timestamptz [not null]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  revoked_reason varchar(128)
}

Table otp_challenges {
  id uuid [pk]
  purpose varchar(32) [not null]
  challenge_hash varchar(64) [unique, not null]
  user_id uuid
  destination varchar(255)
  channel varchar(16)
  client_ip varchar(45)
  code_hash varchar(64)
  code_expires_at timestamptz
  expires_at timestamptz [not null]
  consumed_at timestamptz
  failed_attempts integer [not null]
  send_count integer [not null]
  last_sent_at timestamptz
  created_at timestamptz [not null]
  row_version bigint [not null]
}

Table prospective_customer_registrations {
  id uuid [pk]
  user_id uuid [unique, not null]
  organization_name varchar(200) [not null]
  organization_code varchar(64) [unique, not null]
  asset_category_id uuid [not null]
  asset_code varchar(64) [not null]
  asset_name varchar(200) [not null]
  asset_description varchar(2000)
  asset_location varchar(500) [not null]
  latitude "numeric(9,6)" [not null]
  longitude "numeric(9,6)" [not null]
  ownership_information varchar(1000)
  status varchar(24) [not null]
  airspace_classification varchar(32) [not null]
  review_note varchar(2000)
  reviewed_by_user_id uuid
  reviewed_at timestamptz
  created_at timestamptz [not null]
  row_version bigint [not null]
  structure_height_meters "numeric(8,2)"
  footprint_area_square_meters "numeric(12,2)"
}

Table inspector_applications {
  id uuid [pk]
  normalized_email varchar(320) [not null]
  email varchar(320) [not null]
  full_name varchar(200) [not null]
  phone_number varchar(32)
  citizen_id varchar(32) [not null]
  address varchar(500) [not null]
  pilot_license_number varchar(128) [not null]
  pilot_license_class varchar(64) [not null]
  pilot_license_expires_at timestamptz
  license_scan_file_key varchar(1000) [not null]
  password_hash varchar(1024) [not null]
  status varchar(32) [not null]
  reviewed_by_user_id uuid
  reviewed_at timestamptz
  rejection_reason varchar(1000)
  notification_state varchar(32) [not null]
  cleanup_attempts integer [not null]
  correlation_id varchar(128)
  approved_user_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  signed_contract_file_key varchar(1000)
  signed_contract_sha256 varchar(128)
}

Table inspector_profiles {
  user_id uuid [pk]
  pilot_license_number varchar(128)
  pilot_license_class varchar(64)
  pilot_license_expires_at timestamptz
  pilot_license_file_key varchar(1000)
  pilot_license_issued_date date
  pilot_license_authority varchar(200)
  citizen_id varchar(32)
  date_of_birth date
  address varchar(500)
  prior_flight_hours "numeric(8,2)" [not null]
  certified_drone_models varchar(500)
  specializations varchar(500)
  experience_summary text
  notes text
  updated_at timestamptz [not null]
  onboarding_status varchar(32) [not null]
  partner_contract_file_key varchar(1000)
  partner_contract_sha256 varchar(64)
  partner_contract_uploaded_at timestamptz
  approved_by_user_id uuid
  approved_at timestamptz
  rejection_reason text
}

Table pilot_license_classes {
  id uuid [pk]
  name varchar(64) [unique, not null]
  description varchar(500)
  active boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table inspector_flight_logs {
  id uuid [pk]
  inspector_user_id uuid [not null]
  flight_code varchar(64) [not null]
  flight_date date [not null]
  mission_title varchar(255) [not null]
  drone_model varchar(255) [not null]
  drone_serial_number varchar(128)
  location varchar(500) [not null]
  flight_duration_minutes integer [not null]
  inspection_type varchar(128) [not null]
  safety_incident boolean [not null]
  notes text
  recorded_by_user_id uuid
  created_at timestamptz [not null]
}

Table inspector_reliability_events {
  id uuid [pk]
  inspector_id uuid [not null]
  inspection_id uuid [not null]
  field_session_id uuid
  event_type varchar(24) [not null]
  reason varchar(2000)
  occurred_at timestamptz [not null]
}

Table asset_categories {
  id uuid [pk]
  code varchar(64) [unique, not null]
  name varchar(160) [not null]
  description varchar(2000)
  active boolean [not null]
  row_version bigint [not null]
}

Table inspection_items {
  id uuid [pk]
  category_id uuid [not null]
  label varchar(300) [not null]
  sort_order integer [not null]
  active boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  row_version bigint [not null]
}

Table assets {
  id uuid [pk]
  category_id uuid [not null]
  name varchar(200) [not null]
  description varchar(2000)
  latitude "numeric(9,6)"
  longitude "numeric(9,6)"
  status varchar(24) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  row_version bigint [not null]
  asset_code varchar(64) [not null]
  location jsonb
  technical_profile jsonb
  inspection_items jsonb [not null]
  structure_height_meters "numeric(8,2)"
  footprint_area_square_meters "numeric(12,2)"
  owner_customer_id uuid [not null]
  ownership_information varchar(1000)
}

Table asset_documents {
  id uuid [pk]
  asset_id uuid [not null]
  uploaded_by_user_id uuid [not null]
  document_type varchar(32) [not null]
  file_name varchar(500) [not null]
  content_type varchar(160) [not null]
  size_bytes bigint [not null]
  object_key varchar(1000) [unique, not null]
  document_date date
  created_at timestamptz [not null]
}

Table drones {
  id uuid [pk]
  serial_number varchar(128) [unique, not null]
  model varchar(1000)
  manufacturer varchar(200)
  payload_metadata jsonb
  serviceability varchar(24) [not null]
  notes varchar(2000)
  registration_number varchar(100)
  registration_file_key varchar(1000)
  registration_expires_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  row_version bigint [not null]
  inspector_owner_id uuid
  document_files jsonb
  max_wind_resistance_mps "numeric(4,1)"
  optical_zoom_level varchar(32)
  image_file_keys jsonb
  features jsonb
  max_altitude_meters "numeric(8,1)"
  owner_customer_id uuid
}

Table drone_registration_applications {
  id uuid [pk]
  inspector_user_id uuid [not null]
  serial_number varchar(128) [unique, not null]
  model varchar(1000)
  manufacturer varchar(200)
  registration_number varchar(100) [not null]
  registration_file_key varchar(1000) [not null]
  registration_expires_at timestamptz [not null]
  status varchar(24) [not null]
  review_note varchar(2000)
  reviewed_by_user_id uuid
  reviewed_at timestamptz
  drone_id uuid
  created_at timestamptz [not null]
  row_version bigint [not null]
  document_files jsonb
  max_wind_resistance_mps "numeric(4,1)"
  optical_zoom_level varchar(32)
  image_file_keys jsonb
  features jsonb
  max_altitude_meters "numeric(8,1)"
}

Table drone_document_configs {
  id uuid [pk]
  code varchar(64) [unique, not null]
  title_vi varchar(255) [not null]
  title_en varchar(255) [not null]
  description_vi varchar(1000)
  description_en varchar(1000)
  is_required boolean [not null]
  is_active boolean [not null]
  display_order integer [not null]
