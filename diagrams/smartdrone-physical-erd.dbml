  window_start time [not null]
  window_end time [not null]
  request_type varchar(16) [not null]
  recurrence_unit varchar(16)
  recurrence_interval integer
  occurrence_count integer
  recurrence_end_date date
  status varchar(24) [not null]
  contract_object_key varchar(1000)
  contract_uploaded_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  row_version bigint [not null]
  accepted_quote_id uuid
  accepted_at timestamptz
  accepted_by_user_id uuid
  accepted_terms_snapshot jsonb
  owner_customer_id uuid [not null]
  source_inspection_id uuid
  assigned_manager_id uuid
  manager_assigned_at timestamptz
  manager_assigned_by_user_id uuid
}

Table service_request_messages {
  id uuid [pk]
  request_id uuid [not null]
  author_user_id uuid [not null]
  body varchar(4000) [not null]
