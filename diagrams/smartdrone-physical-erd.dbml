  updated_at timestamptz [not null]
}

Table service_requests {
  id uuid [pk]
  asset_id uuid [not null]
  created_by_user_id uuid [not null]
  description varchar(4000) [not null]
  requested_from date [not null]
  requested_until date [not null]
