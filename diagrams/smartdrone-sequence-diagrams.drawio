        <mxCell id="m_6" value="7a. Return otpRequired = true &amp;amp; challengeId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;dashPattern=4 4;strokeColor=#000000;strokeWidth=1.1;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.9402;exitDx=0;exitDy=0;entryX=1;entryY=0.1053;entryDx=0;entryDy=0;" edge="1" parent="1" source="act_3_0" target="act_1_1">
