        <mxCell id="m_13" value="1b. Click Sign in with Google" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.0759;exitDx=0;exitDy=0;entryX=0;entryY=0.5972;entryDx=0;entryDy=0;" edge="1" parent="1" source="act_0_2" target="act_1_2">
