        <mxCell id="m_7" value="8a. Enter 6-digit OTP code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4615;exitDx=0;exitDy=0;entryX=0;entryY=0.4912;entryDx=0;entryDy=0;" edge="1" parent="1" source="act_0_1" target="act_1_1">
