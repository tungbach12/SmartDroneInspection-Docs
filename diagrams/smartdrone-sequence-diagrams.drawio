        <mxCell id="m_10" value="11a. Consume challenge &amp;amp; mark user verified" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8000;exitDx=0;exitDy=0;entryX=0;entryY=0.1277;entryDx=0;entryDy=0;" edge="1" parent="1" source="act_4_1" target="act_5_1">
