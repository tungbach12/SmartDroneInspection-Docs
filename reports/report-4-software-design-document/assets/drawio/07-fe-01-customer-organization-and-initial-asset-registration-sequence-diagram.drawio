        <mxCell id="msg_0" value="1. Enter email and request registration OTP" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="134" as="sourcePoint"/><mxPoint x="460" y="134" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_1" value="2. POST /api/v1/auth/register/otp" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="192" as="sourcePoint"/><mxPoint x="740" y="192" as="targetPoint"/></mxGeometry></mxCell>
