  <diagram id="08-fe-01-user-sign-in-otp-verification-and-google-oauth-2-0-sequence-diagram.drawio" name="FE-01 User Sign-In, OTP Verification and Google OAuth 2.0 Sequence Diagram">
    <mxGraphModel adaptiveColors="none" dx="1840" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p_0" value="System User" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="40" width="200" height="1300" as="geometry"/></mxCell>
        <mxCell id="p_1" value="Web Portal / Mobile App" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="200" height="1300" as="geometry"/></mxCell>
        <mxCell id="p_2" value="BrowserAuthController / OAuth2Controller" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="200" height="1300" as="geometry"/></mxCell>
        <mxCell id="p_3" value="AuthService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="920" y="40" width="200" height="1300" as="geometry"/></mxCell>
        <mxCell id="p_4" value="LoginOtpService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="1200" y="40" width="200" height="1300" as="geometry"/></mxCell>
        <mxCell id="p_5" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="1480" y="40" width="200" height="1300" as="geometry"/></mxCell>
        <mxCell id="msg_0" value="1. Enter email and password" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="162" as="sourcePoint"/><mxPoint x="460" y="162" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_1" value="2. POST /api/v1/auth/login (or /api/v1/mobile/auth/login)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="220" as="sourcePoint"/><mxPoint x="740" y="220" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_2" value="3. login(email, password, clientIp, userAgent)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="278" as="sourcePoint"/><mxPoint x="1020" y="278" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_3" value="4. Verify Argon2id password hash and lockout status (users)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="336" as="sourcePoint"/><mxPoint x="1580" y="336" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_4" value="5. createLoginChallenge(user, clientIp)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="422" as="sourcePoint"/><mxPoint x="1300" y="422" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_5" value="6. Save LOGIN OtpChallenge (otp_challenges)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="480" as="sourcePoint"/><mxPoint x="1580" y="480" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_6" value="7. Return otpRequired = true and challengeId" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="538" as="sourcePoint"/><mxPoint x="460" y="538" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_7" value="8. Enter 6-digit OTP code" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="596" as="sourcePoint"/><mxPoint x="460" y="596" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_8" value="9. POST /api/v1/auth/login/otp/verify" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="654" as="sourcePoint"/><mxPoint x="740" y="654" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_9" value="10. verifyChallenge(challengeId, otpCode)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="712" as="sourcePoint"/><mxPoint x="1300" y="712" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_10" value="11. Mark OtpChallenge consumed and set user.otp_verified = true" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="770" as="sourcePoint"/><mxPoint x="1580" y="770" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="blk_11" value="alt OTP Challenge Required" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=180;height=24;fillColor=none;strokeColor=#444444;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="380" width="1740" height="458" as="geometry"/></mxCell>
        <mxCell id="msg_12" value="12. Create active AuthSession (auth_sessions) and AuditEvent" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="846" as="sourcePoint"/><mxPoint x="1580" y="846" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_13" value="13. Return HS256 JWT access token and refresh credential" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="904" as="sourcePoint"/><mxPoint x="460" y="904" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="blk_div_14" value="[else Google OAuth 2.0 Sign-In]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=11;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="1720" height="20" as="geometry"/></mxCell>
        <mxCell id="msg_15" value="14. Click Sign in with Google" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="986" as="sourcePoint"/><mxPoint x="460" y="986" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_16" value="15. GET /api/v1/auth/oauth2/google?client=web|mobile" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="1044" as="sourcePoint"/><mxPoint x="740" y="1044" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_17" value="16. Redirect to Google OAuth 2.0 consent screen" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="1102" as="sourcePoint"/><mxPoint x="180" y="1102" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_18" value="17. GET /api/v1/auth/oauth2/google/callback?code=...&amp;state=..." style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="1160" as="sourcePoint"/><mxPoint x="740" y="1160" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_19" value="18. loginWithGoogle(googleProfile, clientType)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="1218" as="sourcePoint"/><mxPoint x="1020" y="1218" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_20" value="19. Match active User and create AuthSession (auth_sessions)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="1276" as="sourcePoint"/><mxPoint x="1580" y="1276" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_21" value="20. Redirect to Web callback or Mobile smartdrone://auth deep link" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="1334" as="sourcePoint"/><mxPoint x="460" y="1334" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="blk_22" value="alt Email &amp; Password Sign-In" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=180;height=24;fillColor=none;strokeColor=#444444;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="1740" height="1282" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
