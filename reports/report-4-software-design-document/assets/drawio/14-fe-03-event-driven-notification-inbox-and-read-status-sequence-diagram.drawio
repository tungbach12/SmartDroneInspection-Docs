        <mxCell id="msg_2" value="3. Deliver event asynchronously to @ApplicationModuleListener" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="250" as="sourcePoint"/><mxPoint x="1300" y="250" as="targetPoint"/></mxGeometry></mxCell>
