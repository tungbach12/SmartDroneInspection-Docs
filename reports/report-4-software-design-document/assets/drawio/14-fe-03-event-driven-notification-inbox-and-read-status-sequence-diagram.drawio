        <mxCell id="msg_0" value="1. Execute domain action (e.g., assign an inspection, abort a session, submit an application)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="134" as="sourcePoint"/><mxPoint x="740" y="134" as="targetPoint"/></mxGeometry></mxCell>
