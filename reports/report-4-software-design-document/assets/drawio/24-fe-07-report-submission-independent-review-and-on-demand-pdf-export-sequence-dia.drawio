        <mxCell id="p_6" value="PostgreSQL &amp; MinIO" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="1760" y="40" width="200" height="836" as="geometry"/></mxCell>
        <mxCell id="msg_0" value="1. POST /api/v1/inspections/{id}/report/ai-summary &amp; POST /report/draft" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="134" as="sourcePoint"/><mxPoint x="1020" y="134" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_1" value="2. generateAiSummary(...) &amp; generateDraft(inspectorId, inspectionId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="192" as="sourcePoint"/><mxPoint x="1300" y="192" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_2" value="3. Create InspectionReport (status = SUBMITTED) and move Inspection to UNDER_REVIEW" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="250" as="sourcePoint"/><mxPoint x="1860" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_3" value="4. POST /api/v1/inspections/{id}/report/versions/{verId}/review (approve = false, reason)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="336" as="sourcePoint"/><mxPoint x="1020" y="336" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_4" value="5. reviewVersion(managerId, inspectionId, verId, false, reason)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="394" as="sourcePoint"/><mxPoint x="1300" y="394" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_5" value="6. Mark InspectionReport RETURNED and revert Inspection to FIELD_COMPLETED" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="452" as="sourcePoint"/><mxPoint x="1860" y="452" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="blk_div_6" value="[else Manager Approves and Directly Publishes Report]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=11;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="498" width="2000" height="20" as="geometry"/></mxCell>
        <mxCell id="msg_7" value="7. POST /api/v1/inspections/{id}/report/versions/{verId}/review (approve = true)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="534" as="sourcePoint"/><mxPoint x="1020" y="534" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_8" value="8. reviewVersion(managerId, inspectionId, verId, true, null)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="592" as="sourcePoint"/><mxPoint x="1300" y="592" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_9" value="9. Mark prior published version SUPERSEDED, set current version PUBLISHED, and Inspection COMPLETED" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="650" as="sourcePoint"/><mxPoint x="1860" y="650" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="blk_10" value="alt Manager Returns Report with Feedback" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=180;height=24;fillColor=none;strokeColor=#444444;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="294" width="2020" height="424" as="geometry"/></mxCell>
        <mxCell id="msg_11" value="10. GET /api/v1/inspections/{id}/report/versions/{verId}/document" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="726" as="sourcePoint"/><mxPoint x="1020" y="726" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_12" value="11. downloadArtefact(actorId, inspectionId, verId, locale)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="784" as="sourcePoint"/><mxPoint x="1300" y="784" as="targetPoint"/></mxGeometry></mxCell>
