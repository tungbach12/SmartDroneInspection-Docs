        <mxCell id="msg_3" value="4. Deliver in-app abort alert notification" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="308" as="sourcePoint"/><mxPoint x="460" y="308" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_4" value="5. PUT /api/v1/inspections/{id}/schedule (plannedStartAt, plannedEndAt)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="394" as="sourcePoint"/><mxPoint x="1020" y="394" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_5" value="6. reschedule(managerId, inspectionId, startAt, endAt)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="452" as="sourcePoint"/><mxPoint x="1580" y="452" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_6" value="7. Check partner schedule conflicts and update planned window" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="510" as="sourcePoint"/><mxPoint x="1860" y="510" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="blk_div_7" value="[else Reassign Inspector and Owned Drone]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=11;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="556" width="2000" height="20" as="geometry"/></mxCell>
        <mxCell id="msg_8" value="8. PUT /api/v1/inspections/{id}/assignment (inspectorId, droneId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="592" as="sourcePoint"/><mxPoint x="1020" y="592" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_9" value="9. reassign(managerId, inspectionId, inspectorId, droneId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="650" as="sourcePoint"/><mxPoint x="1580" y="650" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_10" value="10. Validate pilot license, drone ownership, and schedule availability, then update assignment" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="708" as="sourcePoint"/><mxPoint x="1860" y="708" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="blk_div_11" value="[else Cancel Inspection Mission]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=11;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="754" width="2000" height="20" as="geometry"/></mxCell>
        <mxCell id="msg_12" value="11. POST /api/v1/inspections/{id}/cancellation (reason)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="790" as="sourcePoint"/><mxPoint x="1020" y="790" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_13" value="12. cancel(managerId, inspectionId, reason)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="848" as="sourcePoint"/><mxPoint x="1580" y="848" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_14" value="13. Transition Inspection to CANCELLED" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="906" as="sourcePoint"/><mxPoint x="1860" y="906" as="targetPoint"/></mxGeometry></mxCell>
