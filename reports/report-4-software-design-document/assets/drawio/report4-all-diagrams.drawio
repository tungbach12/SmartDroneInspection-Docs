  <diagram id="19-fe-05-flight-permit-gate-field-session-execution-and-smartdronehub-sync-sequence.drawio" name="FE-05 Flight Permit Gate, Field Session Execution and SmartDroneHub Sync Sequence Diagram">
    <mxGraphModel adaptiveColors="none" dx="1840" dy="1168" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1168" math="0" shadow="0">
