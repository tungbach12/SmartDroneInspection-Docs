        <mxCell id="p_3" value="InspectionDroneHubService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="920" y="40" width="200" height="1068" as="geometry"/></mxCell>
        <mxCell id="p_4" value="SmartDroneHubClient" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="1200" y="40" width="200" height="1068" as="geometry"/></mxCell>
        <mxCell id="p_5" value="PostgreSQL &amp; MinIO" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="1480" y="40" width="200" height="1068" as="geometry"/></mxCell>
        <mxCell id="msg_0" value="1. POST /api/v1/inspections/{id}/flight-permit (MultipartFile)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="134" as="sourcePoint"/><mxPoint x="460" y="134" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_1" value="2. uploadFlightPermit(inspectorId, inspectionId, file)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="192" as="sourcePoint"/><mxPoint x="740" y="192" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_2" value="3. Verify Inspector pilot license is unexpired, store permit in MinIO, and save flight_permit_file_key" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="250" as="sourcePoint"/><mxPoint x="1580" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_3" value="4. POST /api/v1/inspections/{id}/field-sessions (preFlightChecklistNote)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="308" as="sourcePoint"/><mxPoint x="460" y="308" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_4" value="5. start(inspectorId, inspectionId, preFlightChecklistNote)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="366" as="sourcePoint"/><mxPoint x="740" y="366" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_5" value="6. Verify hasFlightPermit() == true, create IN_PROGRESS FieldSession, and mark Inspection IN_PROGRESS" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="424" as="sourcePoint"/><mxPoint x="1580" y="424" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_6" value="7. POST /api/v1/inspections/{id}/field-sessions/{sessId}/drone-hub/connect" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="482" as="sourcePoint"/><mxPoint x="460" y="482" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_7" value="8. connect(inspectorId, inspectionId, sessId, request)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="540" as="sourcePoint"/><mxPoint x="1020" y="540" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_8" value="9. startMission(missionPayload)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="598" as="sourcePoint"/><mxPoint x="1300" y="598" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_9" value="10. GET /flight-report &amp; POST /sync-video" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="656" as="sourcePoint"/><mxPoint x="460" y="656" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_10" value="11. getFlightReport(...) &amp; syncFlightVideo(...)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="714" as="sourcePoint"/><mxPoint x="1020" y="714" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_11" value="12. Fetch telemetry metrics, GPS trace, and recorded MP4 video" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="772" as="sourcePoint"/><mxPoint x="1300" y="772" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_12" value="13. Persist flight_trace_json on field_sessions and MP4 Evidence in MinIO" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="830" as="sourcePoint"/><mxPoint x="1580" y="830" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_13" value="14. POST /api/v1/inspections/{id}/field-sessions/{sessId}/completion (outcomeNotes)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="888" as="sourcePoint"/><mxPoint x="460" y="888" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_14" value="15. complete(inspectorId, inspectionId, sessId, outcomeNotes)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="946" as="sourcePoint"/><mxPoint x="740" y="946" as="targetPoint"/></mxGeometry></mxCell>
