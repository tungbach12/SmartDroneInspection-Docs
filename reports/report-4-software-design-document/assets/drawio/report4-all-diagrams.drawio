  <diagram id="22-fe-06-photo-and-video-evidence-intake-yolo11-detection-and-findings-confirmation.drawio" name="FE-06 Photo and Video Evidence Intake, YOLO11 Detection and Findings Confirmation Sequence Diagram">
    <mxGraphModel adaptiveColors="none" dx="1840" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p_0" value="Assigned Inspector" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="40" width="200" height="1300" as="geometry"/></mxCell>
        <mxCell id="p_1" value="InspectionController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="200" height="1300" as="geometry"/></mxCell>
        <mxCell id="p_2" value="EvidenceService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="200" height="1300" as="geometry"/></mxCell>
        <mxCell id="p_3" value="FindingService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="920" y="40" width="200" height="1300" as="geometry"/></mxCell>
        <mxCell id="p_4" value="PrimaryWithFallbackInference" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="1200" y="40" width="200" height="1300" as="geometry"/></mxCell>
        <mxCell id="p_5" value="PostgreSQL &amp; MinIO" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="1480" y="40" width="200" height="1300" as="geometry"/></mxCell>
        <mxCell id="msg_0" value="1. POST /api/v1/inspections/{id}/evidence (photo &lt;= 10 MB or compatibility video &lt;= 20 MiB)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="134" as="sourcePoint"/><mxPoint x="460" y="134" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_1" value="2. upload(inspectorId, inspectionId, file)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="192" as="sourcePoint"/><mxPoint x="740" y="192" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_2" value="3. Extract EXIF first, normalize &gt;2048 px / rotated image, create 480 px thumb, store in MinIO, save Evidence" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="250" as="sourcePoint"/><mxPoint x="1580" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_3" value="4. POST /evidence/uploads -&gt; PUT .../parts/{n} (10 MiB chunks &lt;= 2 GB) -&gt; POST .../complete" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="308" as="sourcePoint"/><mxPoint x="460" y="308" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_4" value="5. EvidenceUploadSessionService + VideoProcessingWorker (FFmpeg &lt;=1080p faststart + poster, raw deleted only when verified READY)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="366" as="sourcePoint"/><mxPoint x="740" y="366" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_5" value="6. Commit Evidence rendition keys &amp; telemetry, or retain raw as retryable FAILED" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="424" as="sourcePoint"/><mxPoint x="1580" y="424" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_6" value="7. POST .../evidence/{evidId}/media-ticket -&gt; GET/HEAD .../stream?ticket=... (Range)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="482" as="sourcePoint"/><mxPoint x="460" y="482" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_7" value="8. Validate short-lived HMAC ticket &amp; stream HTTP 206 Partial Content from MinIO" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="540" as="sourcePoint"/><mxPoint x="740" y="540" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_8" value="9. POST /api/v1/inspections/{id}/evidence/{evidId}/analyze (or /analyze-video)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="598" as="sourcePoint"/><mxPoint x="460" y="598" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_9" value="10. analyzeEvidence(inspectorId, inspectionId, evidId, replace)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="656" as="sourcePoint"/><mxPoint x="1020" y="656" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_10" value="11. predict(imageBytes, contentType)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="714" as="sourcePoint"/><mxPoint x="1300" y="714" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_11" value="12. Return YOLO11 bounding boxes (or Vision LLM fallback boxes if empty/offline)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="772" as="sourcePoint"/><mxPoint x="1020" y="772" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_12" value="13. Save PENDING Finding rows" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="830" as="sourcePoint"/><mxPoint x="1580" y="830" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_13" value="14. Return candidate Findings with bounding boxes and confidence scores" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="888" as="sourcePoint"/><mxPoint x="180" y="888" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_14" value="15. POST /findings/{findingId}/confirmation &amp; PUT /findings/{findingId}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="946" as="sourcePoint"/><mxPoint x="460" y="946" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_15" value="16. review(inspectorId, inspectionId, findingId, decision)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="1004" as="sourcePoint"/><mxPoint x="1020" y="1004" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_16" value="17. Update Finding status to CONFIRMED (or soft-delete rejected candidate)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="1062" as="sourcePoint"/><mxPoint x="1580" y="1062" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_17" value="18. POST /api/v1/inspections/{id}/findings/confirm" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="1120" as="sourcePoint"/><mxPoint x="460" y="1120" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_18" value="19. confirmFindings(inspectorId, inspectionId, acknowledgeNoFindings)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="1178" as="sourcePoint"/><mxPoint x="1020" y="1178" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_19" value="20. Verify zero PENDING findings remain and set inspections.findings_confirmed_at" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="1236" as="sourcePoint"/><mxPoint x="1580" y="1236" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
