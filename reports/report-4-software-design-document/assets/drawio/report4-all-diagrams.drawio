        <mxCell id="p_3" value="AirspaceAdvisoryService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="920" y="40" width="200" height="952" as="geometry"/></mxCell>
        <mxCell id="p_4" value="MinioEvidenceObjectStore" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="1200" y="40" width="200" height="952" as="geometry"/></mxCell>
        <mxCell id="p_5" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="1480" y="40" width="200" height="952" as="geometry"/></mxCell>
        <mxCell id="msg_0" value="1. POST /api/v1/assets (assetCode, coordinates, inspectionItems)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="134" as="sourcePoint"/><mxPoint x="460" y="134" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_1" value="2. createAsset(actorId, request)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="192" as="sourcePoint"/><mxPoint x="740" y="192" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_2" value="3. evaluate(latitude, longitude, maxAltitudeMeters)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="250" as="sourcePoint"/><mxPoint x="1020" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_3" value="4. NO_FLY_ZONE classification" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="336" as="sourcePoint"/><mxPoint x="740" y="336" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_4" value="5. Return 403 Forbidden (ASSET_IN_NO_FLY_ZONE)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="394" as="sourcePoint"/><mxPoint x="180" y="394" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="blk_div_5" value="[else Clear or Restricted Zone]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=11;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="1720" height="20" as="geometry"/></mxCell>
        <mxCell id="msg_6" value="6. CLEAR_ZONE or RESTRICTED_ZONE" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="476" as="sourcePoint"/><mxPoint x="740" y="476" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_7" value="7. Verify unique (organization_id, asset_code) and save ACTIVE Asset" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="534" as="sourcePoint"/><mxPoint x="1580" y="534" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_8" value="8. Return created Asset with inspection_items JSONB (201 Created)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="592" as="sourcePoint"/><mxPoint x="180" y="592" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="blk_9" value="alt Coordinates inside Prohibited No-Fly Zone" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=180;height=24;fillColor=none;strokeColor=#444444;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="294" width="1740" height="366" as="geometry"/></mxCell>
        <mxCell id="msg_10" value="9. POST /api/v1/assets/{assetId}/documents (MultipartFile)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="668" as="sourcePoint"/><mxPoint x="460" y="668" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_11" value="10. uploadDocument(actorId, assetId, docType, file)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="726" as="sourcePoint"/><mxPoint x="740" y="726" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_12" value="11. Compute SHA-256 checksum and check duplicate on asset" style="html=1;verticalAlign=middle;align=left;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="784" as="sourcePoint"/><mxPoint x="740" y="810" as="targetPoint"/><Array as="points"><mxPoint x="790" y="784"/><mxPoint x="790" y="810"/></Array></mxGeometry></mxCell>
