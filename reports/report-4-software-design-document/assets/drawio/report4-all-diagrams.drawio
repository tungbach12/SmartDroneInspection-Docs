  <diagram id="07-fe-01-customer-organization-and-initial-asset-registration-sequence-diagram.drawio" name="FE-01 Customer Organization and Initial Asset Registration Sequence Diagram">
    <mxGraphModel adaptiveColors="none" dx="2120" dy="1342" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1342" math="0" shadow="0">
