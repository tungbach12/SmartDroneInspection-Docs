        <mxCell id="p_4" value="OrganizationRegistrationService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="1200" y="40" width="200" height="1242" as="geometry"/></mxCell>
        <mxCell id="p_5" value="CustomerAirspacePolicyAdapter" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="1480" y="40" width="200" height="1242" as="geometry"/></mxCell>
        <mxCell id="p_6" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveCoords=0;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;size=54;" vertex="1" parent="1"><mxGeometry x="1760" y="40" width="200" height="1242" as="geometry"/></mxCell>
        <mxCell id="msg_0" value="1. Enter email and request registration OTP" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="134" as="sourcePoint"/><mxPoint x="460" y="134" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_1" value="2. POST /api/v1/auth/register/otp" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="192" as="sourcePoint"/><mxPoint x="740" y="192" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_2" value="3. sendRegistrationOtp(email, clientIp)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="250" as="sourcePoint"/><mxPoint x="1020" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_3" value="4. Save REGISTRATION OtpChallenge (otp_challenges)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="308" as="sourcePoint"/><mxPoint x="1860" y="308" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_4" value="5. Return challengeId and masked destination" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="366" as="sourcePoint"/><mxPoint x="460" y="366" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_5" value="6. Submit organization details, OTP code, and initial asset coordinates" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="424" as="sourcePoint"/><mxPoint x="460" y="424" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_6" value="7. POST /api/v1/auth/register" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="482" as="sourcePoint"/><mxPoint x="740" y="482" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_7" value="8. verifyAndConsume(challengeId, email, otpCode)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="540" as="sourcePoint"/><mxPoint x="1020" y="540" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_8" value="9. Mark OtpChallenge consumed" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="598" as="sourcePoint"/><mxPoint x="1860" y="598" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_9" value="10. register(request)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="656" as="sourcePoint"/><mxPoint x="1300" y="656" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_10" value="11. evaluateFirstAsset(latitude, longitude)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="714" as="sourcePoint"/><mxPoint x="1580" y="714" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_11" value="12. Prohibited zone detected" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="800" as="sourcePoint"/><mxPoint x="1300" y="800" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_12" value="13. Reject registration (403 Forbidden)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="858" as="sourcePoint"/><mxPoint x="460" y="858" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="blk_div_13" value="[else Restricted Zone (RESTRICTED_ZONE)]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=11;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="904" width="2000" height="20" as="geometry"/></mxCell>
        <mxCell id="msg_14" value="14. Restricted zone requires review" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="940" as="sourcePoint"/><mxPoint x="1300" y="940" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_15" value="15. Save PENDING ProspectiveCustomerRegistration and User" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="998" as="sourcePoint"/><mxPoint x="1860" y="998" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_16" value="16. Return 201 Created (pending platform review)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="1056" as="sourcePoint"/><mxPoint x="460" y="1056" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="blk_div_17" value="[else Clear Zone (CLEAR_ZONE)]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=11;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1102" width="2000" height="20" as="geometry"/></mxCell>
        <mxCell id="msg_18" value="17. Clear zone approved" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580" y="1138" as="sourcePoint"/><mxPoint x="1300" y="1138" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_19" value="18. Save ACTIVE Organization, CUSTOMER User, initial Asset, and AuditEvent" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="1196" as="sourcePoint"/><mxPoint x="1860" y="1196" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="msg_20" value="19. Return 201 Created (account active)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="1254" as="sourcePoint"/><mxPoint x="460" y="1254" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="blk_21" value="alt Prohibited No-Fly Zone (NO_FLY_ZONE)" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=180;height=24;fillColor=none;strokeColor=#444444;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="758" width="2020" height="564" as="geometry"/></mxCell>
